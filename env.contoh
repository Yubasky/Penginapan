# Salin isi file ini ke file ".env" di root proyek CI4 (ganti nama dari env bawaan CI4 jika sudah ada)
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = localhost
database.default.database = singgah_medan
database.default.username = postgres
database.default.password = GANTI_PASSWORD
database.default.DBDriver = Postgre
database.default.port = 5432

# Alamat server kelompok kuliner (kosongkan jika belum ada)
kuliner.apiUrl = http://localhost:8081
