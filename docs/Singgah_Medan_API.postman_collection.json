              "raw": "{\n  \"nama\": \"Hotel Uji Postman Medan\",\n  \"kecamatan\": \"Medan Barat\",\n  \"alamat\": \"Jl. Merdeka No. 10, Medan\",\n  \"sarapan\": \"Ya\",\n  \"latitude\": 3.5912,\n  \"longitude\": 98.6771\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"]
            }
          }
