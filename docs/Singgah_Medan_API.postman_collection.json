          }
        },
        {
          "name": "Create Hotel Uji (Admin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) { pm.collectionVariables.set('createdHotelId', res.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
