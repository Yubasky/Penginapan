{
  "info": {
    "name": "Singgah Medan REST API v1",
    "_postman_id": "a7f1b4c2-8d3e-4b2a-9f1c-202611270002",
    "description": "Koleksi Uji Lengkap REST API v1 Singgah Medan (CodeIgniter 4 + PostgreSQL Supabase).\n\nCARA PAKAI:\n1. Isi variabel 'adminPassword' di tab Variables koleksi ini dengan password akun admin@singgahmedan.com Anda.\n2. Klik 'Run' pada koleksi ini — seluruh tes (Login, CRUD Hotel, CRUD Ulasan, Kuliner, serta uji 401/403/409/422/SQLi) akan berjalan otomatis dan aman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "adminEmail", "value": "admin@singgahmedan.com" },
    { "key": "adminPassword", "value": "ISI_PASSWORD_ADMIN_DISINI" },
    { "key": "adminToken", "value": "" },
    { "key": "userEmail", "value": "demo_postman@singgahmedan.com" },
    { "key": "userPassword", "value": "DemoPass123" },
    { "key": "userToken", "value": "" },
    { "key": "apiKey", "value": "sm_295874db28de98e2fe7fe062c3af9c264bed1b80" },
    { "key": "hotelId", "value": "7" },
    { "key": "createdHotelId", "value": "" },
    { "key": "reviewId", "value": "" },
    { "key": "reviewUpdatedAt", "value": "" }
  ],
  "item": [
    {
      "name": "01. Auth (JWT Terpadu)",
      "item": [
        {
          "name": "Login Admin (Dapatkan adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 Login Admin berhasil', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) { pm.collectionVariables.set('adminToken', res.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register Demo User (201 Baru atau 409 Sudah Ada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 atau 409', function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) { pm.collectionVariables.set('userToken', res.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Demo User Postman\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User Biasa (Dapatkan userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 Login User berhasil', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.token) { pm.collectionVariables.set('userToken', res.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Cek Profil Token Aktif (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 Profil User terbaca', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "02. Hotels (CRUD & Kecamatan)",
      "item": [
        {
          "name": "List Hotels (Pagination & Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?kecamatan=Medan Petisah&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "kecamatan", "value": "Medan Petisah" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
