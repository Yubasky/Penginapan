            }
          }
        }
      ]
    },
    {
      "name": "03. Reviews (CRUD Ulasan + Concurrency Lock)",
      "item": [
        {
          "name": "List Reviews per Hotel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews?hotel_id={{hotelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"],
              "query": [
                { "key": "hotel_id", "value": "{{hotelId}}" }
              ]
            }
          }
        },
        {
          "name": "Create Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201 Created', function () { pm.response.to.have.status(201); });",
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "  pm.collectionVariables.set('reviewId', res.data.id);",
                  "  pm.collectionVariables.set('reviewUpdatedAt', res.data.updated_at || '');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotel_id\": 7,\n  \"rating\": 5,\n  \"judul\": \"Nyaman dan dekat kuliner\",\n  \"isi\": \"Lokasi sangat strategis di pusat kota Medan.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"]
            }
          }
        },
        {
          "name": "Update Review (Lock Valid -> 200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200 Updated', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 4,\n  \"judul\": \"Direvisi setelah checkout\",\n  \"isi\": \"Pelayanan baik dan sarapan enak.\",\n  \"updated_at\": \"{{reviewUpdatedAt}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "{{reviewId}}"]
            }
          }
        },
        {
          "name": "Update Review (Lock Usang -> 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 409 Conflict ditangani', function () { pm.response.to.have.status(409); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 3,\n  \"isi\": \"Harus ditolak karena versi lama.\",\n  \"updated_at\": \"2000-01-01 00:00:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "{{reviewId}}"]
            }
          }
        },
        {
          "name": "Delete Review",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200 Deleted', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["reviews", "{{reviewId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "04. Kuliner & Export (Mitra X-API-KEY)",
      "item": [
        {
          "name": "List Kuliner Tersinkron",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{apiKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/kuliner?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["kuliner"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Export Hotels JSON",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Status 200', function () { pm.response.to.have.status(200); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{apiKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/export/hotels?format=json",
              "host": ["{{baseUrl}}"],
              "path": ["export", "hotels"],
              "query": [
                { "key": "format", "value": "json" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05. Uji Keamanan & Error (Checklist E)",
      "item": [
        {
          "name": "Uji 401 - Request Tanpa Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Ditolak 401 Unauthorized', function () { pm.response.to.have.status(401); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"]
            }
          }
        },
        {
          "name": "Uji 403 - User Biasa Coba Create Hotel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Ditolak 403 Forbidden', function () { pm.response.to.have.status(403); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"nama\":\"Tes 403\",\"kecamatan\":\"Medan Baru\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"]
            }
          }
        },
        {
          "name": "Uji 422 - Input Tidak Valid (Rating 99)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Ditolak 422 Validation Error', function () { pm.response.to.have.status(422); });"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"hotel_id\":7,\"rating\":99,\"isi\":\"x\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["reviews"]
            }
          }
        },
        {
          "name": "Uji SQL Injection Sederhana (Aman)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('SQL Injection diblokir (total=0)', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.meta.total).to.eql(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-KEY", "value": "{{apiKey}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/hotels?q=' OR '1'='1' --",
              "host": ["{{baseUrl}}"],
              "path": ["hotels"],
              "query": [
                { "key": "q", "value": "' OR '1'='1' --" }
              ]
            }
          }
        }
      ]
    }
  ]
}
